# Copy to terraform.tfvars (gitignored) and fill in real values. Never commit
# terraform.tfvars or any *.tfstate file — both can contain secrets.

admin_ssh_public_key = "ssh-ed25519 AAAA... you@yourmachine"
admin_ip_cidr         = "203.0.113.4/32" # your current public IP + /32 — check with `curl ifconfig.me`
livekit_domain        = "livekit.yourdomain.com"
acme_email            = "you@yourdomain.com"
key_vault_name        = "kv-chatapp-livekit-01" # must be globally unique in Azure
